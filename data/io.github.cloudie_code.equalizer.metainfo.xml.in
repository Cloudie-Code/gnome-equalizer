<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.cloudie_code.equalizer</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Equalizer</name>
  <summary>Adjust bass, treble, loudness equalization and bass boost of the sound output</summary>
  <description>
    <p>
      Equalizer shapes the sound of whatever output device you pick in GNOME,
      and follows you when you switch from the speakers to headphones.
    </p>
    <ul>
      <li>Six band equalizer from 60 Hz to 15 kHz, −12 to +12 dB, with presets</li>
      <li>Loudness equalization, which evens out quiet and loud passages</li>
      <li>Bass boost</li>
      <li>An equalizer button next to the volume slider in the system menu</li>
    </ul>
  </description>

  <developer id="github.cloudie-code">
    <name translate="no">cloudie-code</name>
  </developer>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/Cloudie-Code/gnome-equalizer/main/data/screenshots/app.png</image>
      <caption>Equalizer settings</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Cloudie-Code/gnome-equalizer/main/data/screenshots/popup.png</image>
      <caption>The equalizer next to the volume slider in the system menu</caption>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/cloudie-code/gnome-equalizer</url>
  <url type="bugtracker">https://github.com/cloudie-code/gnome-equalizer/issues</url>

  <translation type="gettext">gnome-equalizer</translation>
  <launchable type="desktop-id">io.github.cloudie_code.equalizer.desktop</launchable>
  <content_rating type="oars-1.1" />
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <branding>
    <color type="primary" scheme_preference="light">#f9a8c9</color>
    <color type="primary" scheme_preference="dark">#8f2d56</color>
  </branding>

  <releases>
    <release version="0.1.5" date="2026-10-29">
      <description>
        <p>Keep loudness steady while preserving the selected bass balance. Independent bass and midrange protection prevents bass peaks from ducking the whole mix, smoother gain control reduces volume pumping, and lookahead peak protection prevents treble distortion.</p>
      </description>
    </release>
    <release version="0.1.4" date="2026-10-29">
      <description>
        <p>Prevent excessive amplification in passages with little bass by measuring perceived loudness over short and long periods, while preserving audio that is already loud.</p>
      </description>
    </release>
    <release version="0.1.3" date="2026-10-29">
      <description>
        <p>Raise quiet audio towards the output peak ceiling without lowering loud passages, while preserving bass stability and clipping protection.</p>
      </description>
    </release>
    <release version="0.1.2" date="2026-10-23">
      <description>
        <p>Stabilize loudness equalization, reserve headroom for bass peaks, and prevent volume surges during pauses.</p>
      </description>
    </release>
    <release version="0.1.1" date="2026-10-21">
      <description>
        <p>The extension follows the extensions.gnome.org review guidelines. Settings are now stored under org.gnome.shell.extensions.cloudie-equalizer, so the equalizer starts from its defaults again.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-19">
      <description>
        <p>First release.</p>
      </description>
    </release>
  </releases>
</component>
