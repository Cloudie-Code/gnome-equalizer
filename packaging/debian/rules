#!/usr/bin/make -f
%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- -Dsystemd-user-unit-dir=/usr/lib/systemd/user

override_dh_install:
	dh_install
	find debian/gnome-equalizer/usr -name __pycache__ -type d -exec rm -rf {} + 2>/dev/null || true
	find debian/gnome-equalizer/usr -name '*.pyc' -delete 2>/dev/null || true
