#: data/io.github.cloudie_code.equalizer.desktop.in:2
#: data/io.github.cloudie_code.equalizer.metainfo.xml.in:7 daemon/main.c:191
#: extension/extension.js:184 extension/extension.js:262 src/main.py:66
#: src/window.py:35 src/window.py:91 src/window.py:99
msgid "Equalizer"
msgstr "Ekualizadorea"

#: data/io.github.cloudie_code.equalizer.desktop.in:3
msgid "Sound Equalizer"
msgstr "Soinu-ekualizadorea"

#: data/io.github.cloudie_code.equalizer.desktop.in:4
#: data/io.github.cloudie_code.equalizer.metainfo.xml.in:8
msgid ""
"Adjust bass, treble, loudness equalization and bass boost of the sound output"
msgstr "Doitu soinu-irteeraren baxuak, altuak, ozentasun-ekualizazioa eta baxuen indartzea"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/io.github.cloudie_code.equalizer.desktop.in:11
msgid "equalizer;sound;audio;bass;treble;loudness;volume;"
msgstr "ekualizadorea;soinua;audioa;baxuak;altuak;ozentasuna;bolumena;equalizer;"

#: data/io.github.cloudie_code.equalizer.gschema.xml:6
#: extension/extension.js:191
msgid "Apply the equalizer"
msgstr "Aplikatu ekualizadorea"

#: data/io.github.cloudie_code.equalizer.gschema.xml:7
msgid ""
"Whether the equalizer processes the sound of the default output device. When "
"off, the sound passes through unchanged."
msgstr "Ekualizadoreak irteerako gailu lehenetsiaren soinua prozesatzen duen ala ez. Desaktibatuta dagoenean, soinua aldaketarik gabe igarotzen da."

#: data/io.github.cloudie_code.equalizer.gschema.xml:11
msgid "Band gains"
msgstr "Banden irabaziak"

#: data/io.github.cloudie_code.equalizer.gschema.xml:12
msgid ""
"Gain in decibels (−12 to +12) of the 60 Hz, 180 Hz, 550 Hz, 1.6 kHz, 5 kHz "
"and 15 kHz bands."
msgstr "60 Hz, 180 Hz, 550 Hz, 1,6 kHz, 5 kHz eta 15 kHz-eko banden irabazia dezibeletan (−12 eta +12 artean)."

#: data/io.github.cloudie_code.equalizer.gschema.xml:16
#: extension/extension.js:206 src/window.py:107
msgid "Preset"
msgstr "Aurrezarpena"

#: data/io.github.cloudie_code.equalizer.gschema.xml:17
msgid "Identifier of the preset the band gains were taken from, or “custom”."
msgstr "Banden irabaziak hartu diren aurrezarpenaren identifikatzailea, edo “custom”."

#: data/io.github.cloudie_code.equalizer.gschema.xml:21
msgid "Loudness equalization"
msgstr "Ozentasun-ekualizazioa"

#: data/io.github.cloudie_code.equalizer.gschema.xml:22
msgid ""
"Evens out the perceived volume, so quiet passages are raised and loud ones "
"are lowered."
msgstr "Hautemandako bolumena berdintzen du: zati isilak igotzen ditu eta ozenak jaisten."

#: data/io.github.cloudie_code.equalizer.gschema.xml:26
#: data/io.github.cloudie_code.equalizer.metainfo.xml.in:17
msgid "Bass boost"
msgstr "Baxuen indartzea"

#: data/io.github.cloudie_code.equalizer.gschema.xml:27
msgid "Boosts the lowest frequencies with a low shelf filter."
msgstr "Maiztasun baxuenak indartzen ditu apal baxuko iragazki batekin."

#: data/io.github.cloudie_code.equalizer.gschema.xml:32
msgid "Bass boost level"
msgstr "Baxuen indartzearen maila"

#: data/io.github.cloudie_code.equalizer.gschema.xml:33
msgid "How much the bass boost raises the low frequencies, in decibels."
msgstr "Baxuen indartzeak maiztasun baxuak zenbat igotzen dituen, dezibeletan."

#: data/io.github.cloudie_code.equalizer.metainfo.xml.in:10
msgid ""
"Equalizer shapes the sound of whatever output device you pick in GNOME, and "
"follows you when you switch from the speakers to headphones."
msgstr "Ekualizadoreak GNOMEn aukeratzen duzun irteerako gailuaren soinua moldatzen du, eta bozgorailuetatik aurikularretara aldatzean zurekin doa."

#: data/io.github.cloudie_code.equalizer.metainfo.xml.in:15
msgid "Six band equalizer from 60 Hz to 15 kHz, −12 to +12 dB, with presets"
msgstr "Sei bandako ekualizadorea, 60 Hz-etik 15 kHz-era, −12 eta +12 dB artean, aurrezarpenekin"

#: data/io.github.cloudie_code.equalizer.metainfo.xml.in:16
msgid "Loudness equalization, which evens out quiet and loud passages"
msgstr "Ozentasun-ekualizazioa, zati isilak eta ozenak berdintzen dituena"

#: data/io.github.cloudie_code.equalizer.metainfo.xml.in:18
msgid "An equalizer button next to the volume slider in the system menu"
msgstr "Ekualizadore-botoi bat bolumen-graduatzailearen ondoan sistemaren menuan"

#: data/io.github.cloudie_code.equalizer.metainfo.xml.in:44
msgid "First release."
msgstr "Lehen bertsioa."

#. Translators: accessible name of an equalizer slider, %s is a frequency like “1.6k”
#: extension/extension.js:55 src/bands.py:67
#, python-format, javascript-format
msgid "%s Hz"
msgstr "%s Hz"

