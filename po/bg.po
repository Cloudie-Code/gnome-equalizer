#: data/io.github.cloudie_code.equalizer.metainfo.xml.in:7 daemon/main.c:191
#: extension/extension.js:184 extension/extension.js:262 src/main.py:66
#: src/window.py:35 src/window.py:91 src/window.py:99
msgid "Equalizer"
msgstr "Еквалайзер"

#: data/io.github.cloudie_code.equalizer.desktop.in:3
msgid "Sound Equalizer"
msgstr "Звуков еквалайзер"

#: data/io.github.cloudie_code.equalizer.desktop.in:4
#: data/io.github.cloudie_code.equalizer.metainfo.xml.in:8
msgid ""
"Adjust bass, treble, loudness equalization and bass boost of the sound output"
msgstr "Настройка на ниските и високите честоти, изравняването на силата на звука и усилването на басите за звуковия изход"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/io.github.cloudie_code.equalizer.desktop.in:11
msgid "equalizer;sound;audio;bass;treble;loudness;volume;"
msgstr "еквалайзер;звук;аудио;баси;ниски честоти;високи честоти;сила на звука;equalizer;"

#: data/org.gnome.shell.extensions.cloudie-equalizer.gschema.xml:6
#: extension/extension.js:191
msgid "Apply the equalizer"
msgstr "Прилагане на еквалайзера"

#: data/org.gnome.shell.extensions.cloudie-equalizer.gschema.xml:7
msgid ""
"Whether the equalizer processes the sound of the default output device. When "
"off, the sound passes through unchanged."
msgstr "Дали еквалайзерът обработва звука на стандартното изходно устройство. Когато е изключен, звукът минава без промени."

#: data/org.gnome.shell.extensions.cloudie-equalizer.gschema.xml:11
msgid "Band gains"
msgstr "Усилване на лентите"

#: data/org.gnome.shell.extensions.cloudie-equalizer.gschema.xml:12
msgid ""
"Gain in decibels (−12 to +12) of the 60 Hz, 180 Hz, 550 Hz, 1.6 kHz, 5 kHz "
"and 15 kHz bands."
msgstr "Усилване в децибели (от −12 до +12) на лентите 60 Hz, 180 Hz, 550 Hz, 1,6 kHz, 5 kHz и 15 kHz."

#: data/org.gnome.shell.extensions.cloudie-equalizer.gschema.xml:16
#: extension/extension.js:206 src/window.py:107
msgid "Preset"
msgstr "Предварителна настройка"

#: data/org.gnome.shell.extensions.cloudie-equalizer.gschema.xml:17
msgid "Identifier of the preset the band gains were taken from, or “custom”."
msgstr "Идентификатор на предварителната настройка, от която са взети стойностите на лентите, или „custom“."

#: data/org.gnome.shell.extensions.cloudie-equalizer.gschema.xml:21
msgid "Loudness equalization"
msgstr "Изравняване на силата на звука"

#: data/org.gnome.shell.extensions.cloudie-equalizer.gschema.xml:22
msgid ""
"Evens out the perceived volume, so quiet passages are raised and loud ones "
"are lowered."
msgstr "Изравнява възприеманата сила на звука: тихите пасажи се усилват, а силните се заглушават."

#: data/org.gnome.shell.extensions.cloudie-equalizer.gschema.xml:26
#: data/io.github.cloudie_code.equalizer.metainfo.xml.in:17
msgid "Bass boost"
msgstr "Усилване на басите"

#: data/org.gnome.shell.extensions.cloudie-equalizer.gschema.xml:27
msgid "Boosts the lowest frequencies with a low shelf filter."
msgstr "Усилва най-ниските честоти с нискочестотен рафтов филтър."

#: data/org.gnome.shell.extensions.cloudie-equalizer.gschema.xml:32
msgid "Bass boost level"
msgstr "Ниво на усилването на басите"

#: data/org.gnome.shell.extensions.cloudie-equalizer.gschema.xml:33
msgid "How much the bass boost raises the low frequencies, in decibels."
msgstr "Колко усилването на басите повдига ниските честоти, в децибели."

#: data/io.github.cloudie_code.equalizer.metainfo.xml.in:10
msgid ""
"Equalizer shapes the sound of whatever output device you pick in GNOME, and "
"follows you when you switch from the speakers to headphones."
msgstr "Еквалайзер оформя звука на изходното устройство, избрано в GNOME, и ви следва, когато превключите от високоговорителите към слушалките."

#: data/io.github.cloudie_code.equalizer.metainfo.xml.in:15
msgid "Six band equalizer from 60 Hz to 15 kHz, −12 to +12 dB, with presets"
msgstr "Шестлентов еквалайзер от 60 Hz до 15 kHz, от −12 до +12 dB, с предварителни настройки"

#: data/io.github.cloudie_code.equalizer.metainfo.xml.in:16
msgid "Loudness equalization, which evens out quiet and loud passages"
msgstr "Изравняване на силата на звука, което изглажда тихите и силните пасажи"

#: data/io.github.cloudie_code.equalizer.metainfo.xml.in:18
msgid "An equalizer button next to the volume slider in the system menu"
msgstr "Бутон за еквалайзера до плъзгача за сила на звука в системното меню"

#: data/io.github.cloudie_code.equalizer.metainfo.xml.in:44
msgid "First release."
msgstr "Първо издание."

